<Window x:Class="EyeTrackerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EyeTrackerWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="Black">
        <Viewbox Stretch="Uniform">
            <Canvas x:Name="OverlayCanvas">
                <Image x:Name="CameraView"/>
                <Rectangle x:Name="FaceBox" Stroke="Red" StrokeThickness="2" Fill="Transparent"/>
                <Ellipse x:Name="LeftPupilMark" Width="6" Height="6" Fill="Lime" Visibility="Collapsed"/>
                <Ellipse x:Name="RightPupilMark" Width="6" Height="6" Fill="Lime" Visibility="Collapsed"/>
            </Canvas>
        </Viewbox>
        <TextBlock x:Name="StatusText"
               Text="카메라 연결 중..."
               Foreground="White"
               FontSize="16"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
        <Viewbox Stretch="Uniform" MaxWidth="300"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
            <Canvas x:Name="CharacterCanvas" Width="793" Height="446" Background="Transparent">
                <Image Source="Image/catImage.png" Width="793" Height="446"/>
                <Ellipse x:Name="LeftEyeWhite" Width="204" Height="152"
                         Fill="Transparent" Canvas.Left="154" Canvas.Top="204"/>
                <Ellipse x:Name="LeftEyePupil" Width="55" Height="55" Fill="Black"/>
                <Ellipse x:Name="RightEyeWhite" Width="204" Height="152"
                         Fill="Transparent" Canvas.Left="456" Canvas.Top="204"/>
                <Ellipse x:Name="RightEyePupil" Width="55" Height="55" Fill="Black"/>
            </Canvas>
        </Viewbox>
    </Grid>
</Window>
